// Tang Primer 20K Dock: pins of kvm_top (sources: Dock 3714 schematic, Sipeed examples)

// Clock 27 MHz
IO_LOC "clk_27m" H11;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// K0: global reset, 3.3 V
IO_LOC "key0_n" T10;
IO_PORT "key0_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART to BL702 (USB COM port), pins from Sipeed UART example
IO_LOC "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// CPU GPIO bits 0..5: LED0..LED5, active low. C13 = DONE, A13 = READY (dual-purpose as GPIO)
IO_LOC "gpio[0]" C13;
IO_PORT "gpio[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio[1]" A13;
IO_PORT "gpio[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio[2]" N16;
IO_PORT "gpio[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio[3]" N14;
IO_PORT "gpio[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio[4]" L14;
IO_PORT "gpio[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio[5]" L16;
IO_PORT "gpio[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// K1..K3 (T3, T2, D7) and DIP SW0..SW4 (C7, E9, E8, T4, T5) are NOT used: each is the [B] half of an
// IO pair whose [A] half is a DDR3 pin, and the DDR3 PHY serializers occupy both halves
// (Gowin PR2034 "location has already been used").

// HDMI input: Sipeed PMOD_DVI module in PMOD J6 (Dock HDMI connector is not used: no 50R RX termination).
// True LVDS pairs of J6 (SoM 3961 schematic): C12/B12 = IOL7A/B, B13/A14 = IOL8A/B, B14/A15 = IOL2A/B,
// D14/E15 = IOT44A/B. Module wiring: CKP C12, CKN B12 - clock polarity is direct;
// data pairs have P on the [B] pin (D0P A14, D1P A15, D2P E15) -> the receiver must invert the data.
// Bank 7, VCCIO 3.3 V: LVDS25 input is allowed at VCCIO 3.3 V (GW2A datasheet table 2-2).
IO_LOC "tmds_clk_p" C12,B12;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE;
// data: port _p is on the [A] pin = module DxN (polarity inverted, corrected in hdmi_rx.sv)
IO_LOC "tmds_d_p[0]" B13,A14;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC "tmds_d_p[1]" B14,A15;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC "tmds_d_p[2]" D14,E15;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVDS25 PULL_MODE=NONE;

// PMOD_DVI DDC/HPD by wires to PMOD J5 (3.3 V levels on the module, pull-ups on the module):
// SCL A11, SDA N6 (EDID, I2C slave 0x50, open drain), HPD N9 (output)
IO_LOC "hdmi_scl" A11;
IO_PORT "hdmi_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "hdmi_sda" N6;
IO_PORT "hdmi_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "hdmi_hpd" N9;
IO_PORT "hdmi_hpd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Ethernet RTL8201F, RMII (pins: Dock schematic P005, Sipeed Ethernet example).
// RXD0/RXD1/CRS_DV/RXER are PHY strap pins with board resistors -> no FPGA pull.
IO_LOC "eth_ref_clk" A9;
IO_PORT "eth_ref_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "eth_rxd[0]" F15;
IO_PORT "eth_rxd[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "eth_rxd[1]" C9;
IO_PORT "eth_rxd[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "eth_crs_dv" M6;
IO_PORT "eth_crs_dv" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "eth_rx_er" L8;
IO_PORT "eth_rx_er" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "eth_txd[0]" D16;
IO_PORT "eth_txd[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "eth_txd[1]" E14;
IO_PORT "eth_txd[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "eth_tx_en" E16;
IO_PORT "eth_tx_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "eth_rst_n" F10;
IO_PORT "eth_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Ethernet MDC/MDIO (shared with HDMI DDC via 2N7002 level shifters, 1.5k pull-ups on the FPGA side)
IO_LOC "eth_mdc" F14;
IO_PORT "eth_mdc" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "eth_mdio" F16;
IO_PORT "eth_mdio" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

