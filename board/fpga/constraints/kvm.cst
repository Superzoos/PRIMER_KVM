// PLL sites (SUG935 A.3, INS_LOC ... PLL_L[n]/PLL_R). Without them the placer distributes the 3 rPLLs
// differently from build to build, and DDR3 calibration depends on the placement.
//  - DVI RX: its clock input C12/B12 is the dedicated input of LPLL1 (pin report); elsewhere it is routed
//    by generic routing (PR1014 "Generic routing resource will be used to clock signal HDMI_CLK").
//  - DDR3 memory clock: LPLL2, its dedicated pins (F7/E8, C4/B5) are in bank 6 among the DDR3 lines.
//  - core: input from the global clock pin H11, any site; right side.
// Mapping PLL_L[0]/PLL_L[1] <-> LPLL1/LPLL2 is not documented: if PR1014 is still in the P&R log,
// swap PLL_L[0] and PLL_L[1] below.
INS_LOC "u_dvi_rx/dvi2rgb_inst/rPLL_inst" PLL_L[0];
INS_LOC "u_pll_ddr/rpll_inst" PLL_L[1];
INS_LOC "u_clk_rst/u_pll/rpll_inst" PLL_R;

// USB3317 (ULPI) on the Dock -> USB-C to the remote PC (pins: Sipeed TangPrimer-20K-example usb_cdc .cst).
// RESETB of USB3317 = F10 (eth_rst_n, shared with RTL8201F). SW2 on the Dock: DEVICE.
IO_LOC "ulpi_clk" T15;
// CLKOUT of USB3317 is high-Z while its RESETB = 0: weak pull-down so the clock input does not float
IO_PORT "ulpi_clk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ulpi_dir" K12;
IO_PORT "ulpi_dir" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "ulpi_nxt" K13;
IO_PORT "ulpi_nxt" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "ulpi_stp" K11;
IO_PORT "ulpi_stp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "ulpi_data[0]" G11;
IO_LOC "ulpi_data[1]" H12;
IO_LOC "ulpi_data[2]" J12;
IO_LOC "ulpi_data[3]" H13;
IO_LOC "ulpi_data[4]" T14;
IO_LOC "ulpi_data[5]" R13;
IO_LOC "ulpi_data[6]" P13;
IO_LOC "ulpi_data[7]" R12;
IO_PORT "ulpi_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "ulpi_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "ulpi_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "ulpi_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "ulpi_data[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "ulpi_data[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "ulpi_data[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "ulpi_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
